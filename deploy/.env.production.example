# Copy to `.env` next to docker-compose.yml on the server and fill in real values.
# Docker Compose auto-loads `.env`. Keep it OUT of git (it holds secrets).

# The password of the `comfyzone` role you create on the HOST Postgres
# (see README). Generate a strong one, e.g.:  openssl rand -hex 24
COMFYZONE_DATABASE_PASSWORD=change-me

# The Rails master key — the contents of config/master.key for this app.
# (master.key is gitignored/dockerignored, so it's supplied here at runtime.)
RAILS_MASTER_KEY=change-me

# --- Optional: email, so "forgot password" can send a reset link ---
# Any SMTP service works (Brevo, Mailgun, Zoho, Gmail with an app password).
# Leave these out and the app runs fine without sending mail.
# SMTP_ADDRESS=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM="The Comfy Zone <hello@comfyzone.shop>"

# --- Optional: push notifications to phones ---
# Make the pair ONCE and keep it: changing it silently disconnects every
# phone that switched notifications on.
#   docker compose run --rm web ./bin/rails push:keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
