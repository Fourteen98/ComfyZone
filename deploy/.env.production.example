# Copy to `.env` next to docker-compose.yml on the server and fill in real values.
# Docker Compose auto-loads `.env`. Keep it OUT of git (it holds secrets).

# The password of the `comfyzone` role you create on the HOST Postgres
# (see README). Generate a strong one, e.g.:  openssl rand -hex 24
COMFYZONE_DATABASE_PASSWORD=change-me

# The Rails master key — the contents of config/master.key for this app.
# (master.key is gitignored/dockerignored, so it's supplied here at runtime.)
RAILS_MASTER_KEY=change-me
